# Streamlit Secrets Template
# Copy this to ~/.streamlit/secrets.toml on your local machine
# or add these as environment variables on Streamlit Cloud

# OpenAI API Key
OPENAI_API_KEY = "your_openai_api_key_here"

# Google Gemini API Key
GEMINI_API_KEY = "your_gemini_api_key_here"

# Database credentials (if using PostgreSQL/pgml)
# DB_HOST = "localhost"
# DB_PORT = 5432
# DB_NAME = "missedcall_db"
# DB_USER = "postgres"
# DB_PASSWORD = "your_password"
